# Copy to .env for local development. NEVER commit a real .env file
# (see .gitignore) and NEVER put production secrets here — production
# configuration must come from a secrets manager (Document 2 Section 6).

OKAPI_SERVICE_NAME=okapi-copilot
OKAPI_ENVIRONMENT=local
OKAPI_CONTRACT_VERSION=1

OKAPI_HTTP_HOST=0.0.0.0
OKAPI_HTTP_PORT=8000

OKAPI_SURREALDB_URL=ws://localhost:8000/rpc
OKAPI_SURREALDB_NAMESPACE=okapi
OKAPI_SURREALDB_DATABASE=copilot
OKAPI_SURREALDB_USERNAME=root
OKAPI_SURREALDB_PASSWORD=change-me-local-only

OKAPI_REDIS_URL=redis://localhost:6379/0

OKAPI_BROKER_URL=amqp://guest:guest@localhost:5672/

OKAPI_KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/okapi
OKAPI_KEYCLOAK_AUDIENCE=okapi-copilot

OKAPI_OTEL_EXPORTER_ENDPOINT=
OKAPI_LOG_LEVEL=INFO
